  id = id || stack[stack.length - 1]; if (!id || !stack.includes(id)) return;
  $('#' + id).classList.remove('open');
  stack.splice(stack.indexOf(id), 1);
  if (!stack.length){ $('#overlay').classList.remove('open'); document.body.style.overflow = ''; }
