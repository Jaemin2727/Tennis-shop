const KEY = 'courtside_v1';
let mem = null;
function load(){
  try { const v = JSON.parse(localStorage.getItem(KEY)); if (v) return v; } catch(e){}
  return mem || { users:{}, session:null, cart:[] };
}
function save(){
  mem = db;
  try { localStorage.setItem(KEY, JSON.stringify(db)); } catch(e){}
}
