    $('#cartBody').innerHTML = `<div class="cart-empty"><img src="img/ball-practice.svg" alt=""><b style="color:var(--ink);font-size:17px">장바구니가 비어 있어요</b><p style="margin:6px 0 18px">마음에 드는 장비를 담아보세요.</p><button class="btn btn-primary" data-go="all" data-close>쇼핑하러 가기</button></div>`;
    $('#cartFoot').innerHTML = ''; return;
