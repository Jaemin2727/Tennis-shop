/* ---------- 히어로 슬라이더 ---------- */
const hero = (() => {
  const slides = $$('.slide'), N = slides.length, DUR = 6000;
  let i = 0, timer = null, paused = false;
  $('#heroTotal').textContent = String(N).padStart(2,'0');
  $('#dots').innerHTML = slides.map((_, k) => `<button class="dot" aria-label="${k+1}번 슬라이드"><i></i></button>`).join('');
  const dots = $$('.dot');
  document.documentElement.style.setProperty('--dur', DUR + 'ms');
  function go(n){
    i = (n + N) % N;
    slides.forEach((s, k) => { s.classList.toggle('active', k === i); s.setAttribute('aria-hidden', k !== i); });
    dots.forEach((d, k) => { d.classList.remove('active'); d.classList.toggle('done', k < i); });
    void dots[i].offsetWidth; dots[i].classList.add('active');
    $('#heroCur').textContent = String(i+1).padStart(2,'0');
    schedule();
  }
  let start = 0, remain = DUR;
  function schedule(){ clearTimeout(timer); remain = DUR; start = Date.now(); if (!paused) timer = setTimeout(() => go(i+1), remain); }
  function pause(){ if (paused) return; paused = true; clearTimeout(timer); remain -= Date.now() - start; $('#hero').classList.add('paused'); }
  function resume(){ if (!paused) return; paused = false; start = Date.now(); $('#hero').classList.remove('paused'); timer = setTimeout(() => go(i+1), Math.max(300, remain)); }
  dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
  $('#prevSlide').onclick = () => go(i-1);
  $('#nextSlide').onclick = () => go(i+1);
  const h = $('#hero');
  document.addEventListener('visibilitychange', () => document.hidden ? pause() : resume());
  let x0 = null;
  h.addEventListener('touchstart', e => x0 = e.touches[0].clientX, { passive:true });
  h.addEventListener('touchend', e => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) go(i + (dx < 0 ? 1 : -1)); x0 = null; });
  go(0);
  return { go };
})();

