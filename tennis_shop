// 데모용 단방향 해시 (실제 서비스는 서버에서 bcrypt 등 사용)
const hash = s => { let h = 5381; for (const c of s + '::courtside') h = (h * 33 ^ c.charCodeAt(0)) >>> 0; return h.toString(16); };
const me = () => db.session ? db.users[db.session] : null;

/* ---------- 가격 계산 ---------- */
function unitPrice(item){
  const p = byId(item.id);
  let u = p.price;
  (p.options || []).forEach(o => { const v = o.values.find(x => x.l == item.opt[o.name]); if (v && v.add) u += v.add; });
  if (item.opt.job) u += byId(item.opt.job.string).price;
  return u;
}
function laborFor(user){ const g = user ? gradeFor(user.spent) : GRADES[0]; return LABOR * g.labor; }
function totals(user, usePoints = 0){
  const goods = db.cart.reduce((s, it) => s + unitPrice(it) * it.qty, 0);
  const jobs = db.cart.reduce((s, it) => s + (it.opt.job ? it.qty : 0), 0);
  const labor = jobs * laborFor(user);
  const g = user ? gradeFor(user.spent) : GRADES[0];
  const ship = goods === 0 ? 0 : (g.freeShip || goods >= FREE_SHIP ? 0 : SHIP_FEE);
  const max = goods + labor + ship;
  const use = Math.max(0, Math.min(usePoints, max, user ? user.points : 0));
  const pay = max - use;
  const earnBase = Math.max(0, goods + labor - use);
  return { goods, labor, ship, use, pay, earn: Math.floor(earnBase * g.rate), grade: g, jobs, laborFull: jobs * LABOR };
}

