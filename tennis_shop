      ${extra ? `<div class="sum-row"><span></span><small style="color:var(--muted)">${esc(extra)}</small></div>` : ''}
      <div class="sum-row"><span>포인트 사용</span><span class="minus">−${pt(t.use)}</span></div>
      <div class="sum-row total"><span>${pending ? '입금할 금액' : '결제금액'}</span><span>${won(t.pay)}</span></div>
      <div class="earn">${pending ? `입금 확인 후 ${pt(t.earn)} 적립 예정` : `${pt(t.earn)} 적립 완료 · 보유 ${pt(u.points)}`}</div>
    </div>
    <div class="pd-btns"><button class="btn btn-line" id="goOrders">주문내역 보기</button><button class="btn btn-primary" data-close id="keepShop">쇼핑 계속하기</button></div>`;
  $('#goOrders').onclick = () => { close('doneModal'); openMy('orders'); };
  $('#keepShop').onclick = () => close('doneModal');
  open('doneModal');
}
function applyEarn(u, o){
  u.spent += o.goods + o.labor;
  if (o.earn){ u.points += o.earn; u.plog.unshift({ date: today(), desc: `주문 ${o.id} 구매 적립`, amt: o.earn }); }
  o.earned = true;
}

/* ---------- 마이페이지 ---------- */
let myTab = 'orders';
function openMy(tab){ if (tab) myTab = tab; renderMy(); open('myModal'); }
function renderMy(){
  const u = me(); if (!u) return;
  const g = gradeFor(u.spent), n = nextGrade(g);
  const prog = n ? Math.min(100, (u.spent - g.min) / (n.min - g.min) * 100) : 100;
  const body = myTab === 'orders'
    ? (u.orders.length ? u.orders.map(o => `
      <div class="ord"><div class="ord-h"><span>${o.date} · 주문번호 <b style="color:var(--ink)">${o.id}</b></span><span class="status ${o.status === '입금대기' ? 'wait' : ''}">${o.status}</span></div>
        <div class="ord-items">${o.items.map(i => `${esc(i.name)} × ${i.qty}`).join('<br>')}</div>
        <div class="ord-f"><span style="color:var(--muted)">${PAY.find(p => p.id === o.method).ko}${o.used ? ` · 포인트 ${pt(o.used)} 사용` : ''}</span>
          <span><b>${won(o.pay)}</b> ${o.earned ? `<span class="earn" style="display:inline-flex;margin-left:8px">+${pt(o.earn)}</span>` : `<button class="btn btn-sm btn-ball" data-paid="${o.id}" style="margin-left:8px">입금 확인 (데모)</button>`}</span></div></div>`).join('')
      : `<div class="cart-empty"><b style="color:var(--ink)">아직 주문 내역이 없어요</b><p style="margin-top:6px">첫 주문하고 포인트를 쌓아보세요.</p></div>`)
    : myTab === 'points'
    ? `<div class="sum-row" style="font-size:15px;margin-bottom:6px"><b>보유 포인트</b><b style="color:var(--green)">${pt(u.points)}</b></div>
       ${u.plog.map(l => `<div class="plog"><div>${esc(l.desc)}<br><small>${l.date}</small></div><div class="amt ${l.amt > 0 ? 'plus' : 'minus'}">${l.amt > 0 ? '+' : ''}${pt(l.amt)}</div></div>`).join('')}`
    : `<table class="spec-table"><tr><td>이름</td><td>${esc(u.name)}</td></tr><tr><td>이메일</td><td>${esc(u.email)}</td></tr><tr><td>휴대폰</td><td>${esc(u.phone)}</td></tr><tr><td>가입일</td><td>${u.joined}</td></tr><tr><td>마케팅 수신</td><td>${u.mkt ? '동의' : '미동의'}</td></tr><tr><td>누적 구매금액</td><td>${won(u.spent)}</td></tr></table>
       <button class="btn btn-line" id="logoutBtn">로그아웃</button>`;
  $('#myBody').innerHTML = `
    <div class="my-hero">
      <div class="my-top"><div class="my-av">${esc(u.name[0])}</div><div><span class="gr-pill">${g.id}</span><span style="opacity:.8;font-size:14px">${g.ko} 등급 · ${Math.round(g.rate*100)}% 적립</span><h3>${esc(u.name)}님, 오늘도 좋은 랠리 되세요</h3></div></div>
      <div class="my-stats"><div class="pt">보유 포인트<b>${pt(u.points)}</b></div><div>누적 구매<b>${won(u.spent)}</b></div><div>주문<b>${u.orders.length}건</b></div></div>
      <div class="prog">${n ? `<b>${n.id}</b>까지 <b style="color:var(--ball)">${won(n.min - u.spent)}</b> 남았어요` : '최고 등급 <b style="color:var(--ball)">GRAND SLAM</b> 달성! 🏆'}<div class="bar"><i style="width:${prog}%"></i></div>
        <span style="opacity:.6;font-size:12px">${g.perks.join(' · ')}</span></div>
    </div>
    <div class="my-tabs">${[['orders','주문내역'],['points','포인트 내역'],['info','회원정보']].map(([k, l]) => `<button data-mt="${k}" class="${myTab === k ? 'on' : ''}">${l}</button>`).join('')}</div>
    <div class="my-body">${body}</div>`;
}
$('#myBody').addEventListener('click', e => {
  const t = e.target.closest('[data-mt]'); if (t){ myTab = t.dataset.mt; renderMy(); return; }
  if (e.target.closest('#logoutBtn')) return logout();
  const pd = e.target.closest('[data-paid]');
  if (pd){ const u = me(); const o = u.orders.find(x => x.id === pd.dataset.paid); const before = gradeFor(u.spent);
    o.status = '결제완료'; applyEarn(u, o); save(); refreshAll(); renderMy();
    const after = gradeFor(u.spent);
    toast(after !== before ? `입금 확인! 등급이 ${after.id}(으)로 올랐어요` : `입금 확인 · ${pt(o.earn)} 적립됐어요`, 'P'); }
});

/* ---------- 라켓 파인더 ---------- */
const ans = {};
$('#finder').addEventListener('click', e => {
  const b = e.target.closest('.opt'); if (!b) return;
  const q = b.closest('.q').dataset.q; ans[q] = b.dataset.v;
  $$('.opt', b.parentElement).forEach(o => o.classList.toggle('on', o === b));
  if (ans.level && ans.style && ans.swing) recommend();
});
function recommend(){
  const rackets = P.filter(p => p.cat === 'racket');
  const scored = rackets.map(r => ({ r, s: (r.fit.level.includes(ans.level) ? 5 : 0) + (r.fit.style.includes(ans.style) ? 3 : 0) + (r.fit.swing.includes(ans.swing) ? 2 : 0) + (r.fit.style[0] === ans.style ? 1 : 0) }));
  const best = scored.sort((a, b) => b.s - a.s)[0].r;
  const str = ans.style === 'spin' ? 'hexabite' : ans.level === 'beginner' || ans.level === 'junior' ? 'multifeel' : ans.style === 'control' ? 'polyspin' : ans.style === 'power' ? 'multifeel' : 'synthetic';
  const box = $('#finderResult');
  box.innerHTML = `<img src="img/${best.img}.svg" alt=""><div style="flex:1"><small>YOUR MATCH</small><h4>${best.name}</h4><p>${best.specs['무게(언스트링)'] || best.specs['무게']} · ${best.specs['헤드 사이즈']} — 함께 추천: ${byId(str).name}</p></div><button class="btn btn-ball btn-sm" data-open="${best.id}">보기</button>`;
  box.classList.remove('show'); void box.offsetWidth; box.classList.add('show');
}
$('#finderResult').addEventListener('click', e => { const b = e.target.closest('[data-open]'); if (b) openProduct(b.dataset.open); });

/* ---------- 스트링 랩 ---------- */
$('#strings').innerHTML = STRINGS_FOR_JOB.map(s => `
  <button class="sCard reveal" data-sid="${s.id}"><img src="img/${s.img}.svg" alt="" loading="lazy"><small>${s.type}</small><h4>${s.name}</h4>
    ${Object.entries(s.meters).map(([k, v]) => `<div class="meter">${k}<span><i style="--w:${v}%"></i></span></div>`).join('')}
    <div style="margin-top:12px;display:flex;justify-content:space-between;font-size:13px"><span style="color:rgba(255,255,255,.6)">권장 ${s.tension}</span><b>${won(s.price)}</b></div></button>`).join('');
$('#strings').addEventListener('click', e => { const c = e.target.closest('[data-sid]'); if (c) openProduct(c.dataset.sid); });
const tR = $('#tRange');
function tension(){
  const v = +tR.value; const p = (v - 40) / 22 * 100;
  tR.style.setProperty('--p', p + '%');
  $('#tVal').textContent = v; $('#tKg').textContent = (v * .4536).toFixed(1);
  const lvl = ['매우 높음','높음','보통','낮음','매우 낮음'];
  const idx = Math.min(4, Math.floor(p / 20.01));
  $('#tPow').textContent = lvl[idx]; $('#tCtl').textContent = lvl[4 - idx];
  $('#tTip').innerHTML = v <= 45 ? '<b>루즈 텐션</b> — 공이 오래 머물며 잘 날아가요. 폴리 스트링이나 팔이 편한 세팅을 원할 때 좋아요.'
    : v <= 51 ? '<b>미디엄-로우</b> — 파워와 컨트롤의 균형점. 폴리 스트링 사용자에게 가장 인기 있는 구간이에요.'
    : v <= 56 ? '<b>미디엄</b> — 대부분의 멀티·신세틱 스트링 권장 범위. 처음이라면 이 구간에서 시작해보세요.'
    : '<b>타이트 텐션</b> — 공이 덜 날아가 큰 스윙에도 안정적이에요. 대신 스위트스폿이 좁아지고 팔에 부담이 커져요.';
}
tR.addEventListener('input', tension); tension();

/* ---------- 멤버십 ---------- */
const TIER_ICON = ['<circle cx="12" cy="12" r="8"/>','<path d="M4 16l8-10 8 10"/>','<path d="M12 3l2.6 5.6 6 .6-4.6 4 1.4 6L12 16l-5.4 3.2 1.4-6-4.6-4 6-.6Z"/>','<path d="M8 4h8v5a4 4 0 0 1-8 0Z"/><path d="M8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 13v4M8 20h8"/>'];
function renderTiers(){
  const u = me(); const mine = u ? gradeFor(u.spent) : null;
  $('#tiers').innerHTML = GRADES.map((g, k) => `
    <div class="tier ${k === 3 ? 'gs' : ''} ${mine === g ? 'me' : ''}">
      <div class="tier-badge" style="background:${g.color};color:${g.fg}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">${TIER_ICON[k]}</svg></div>
      <h3>${g.id}</h3><div class="ko">${g.ko}</div>
      <div class="rate">${Math.round(g.rate*100)}%<small>적립</small></div>
      <div class="cond">${g.min ? `누적 구매 ${won(g.min)} 이상` : '회원가입 즉시'}</div>
      <ul>${g.perks.map(p => `<li>${p}</li>`).join('')}</ul>
    </div>`).join('');
  $('#memberCta').innerHTML = u
    ? `<div><h3 class="display">${esc(u.name)}님은 ${mine.id}</h3><p>보유 포인트 ${pt(u.points)} · ${nextGrade(mine) ? `${nextGrade(mine).id}까지 ${won(nextGrade(mine).min - u.spent)}` : '최고 등급 달성!'}</p></div><button class="btn btn-primary" data-my>마이페이지</button>`
    : `<div><h3 class="display">Join & Get 3,000P</h3><p>지금 가입하면 웰컴 포인트 3,000P를 바로 드려요.</p></div><button class="btn btn-primary" data-auth="signup">무료 회원가입</button>`;
}

/* ---------- 검색 ---------- */
$('#searchBtn').onclick = () => { $('#searchInput').value = ''; renderSearch(''); open('searchModal'); };
function renderSearch(q){
  q = q.trim().toLowerCase();
  if (!q){ $('#searchRes').innerHTML = `<div class="s-hint">추천 검색어<br>${['스핀','입문','폴리','300g','클레이','오버그립'].map(k => `<button data-kw="${k}">${k}</button>`).join('')}</div>`; return; }
  const r = P.filter(p => [p.name, p.brand, ...p.tags, p.desc, CATS.find(c => c.id === p.cat).ko].join(' ').toLowerCase().includes(q));
  $('#searchRes').innerHTML = r.length ? r.map(p => `<button class="s-item" data-sp="${p.id}"><img src="img/${p.img}.svg" alt=""><span><b>${esc(p.name)}</b><small>${p.brand} · ${CATS.find(c => c.id === p.cat).ko}</small></span><b>${won(p.price)}</b></button>`).join('')
    : `<div class="s-hint">‘${esc(q)}’에 대한 결과가 없어요.</div>`;
}
$('#searchInput').addEventListener('input', e => renderSearch(e.target.value));
$('#searchRes').addEventListener('click', e => {
  const k = e.target.closest('[data-kw]'); if (k){ $('#searchInput').value = k.dataset.kw; renderSearch(k.dataset.kw); return; }
  const s = e.target.closest('[data-sp]'); if (s){ close('searchModal'); openProduct(s.dataset.sp); }
});

/* ---------- 기타 ---------- */
$('#menuBtn').onclick = () => open('mnav');
$('#newsForm').addEventListener('submit', e => { e.preventDefault(); e.target.reset(); toast('구독 완료! 신상품 소식을 보내드릴게요', '✉'); });

const io = 'IntersectionObserver' in window ? new IntersectionObserver(es => es.forEach(en => {
  if (en.isIntersecting){ en.target.classList.add('in'); if (en.target.id === 'lab') en.target.classList.add('inview'); io.unobserve(en.target); }
}), { threshold: .12 }) : null;
function observe(els){ els.forEach(el => io ? io.observe(el) : el.classList.add('in')); }

function refreshAll(){ renderHeader(); renderGrid(); renderCart(); renderTiers(); }
renderTabs(); refreshAll();
observe([...$$('.reveal'), $('#lab')]);
})();
</script>
</body>
</html>
