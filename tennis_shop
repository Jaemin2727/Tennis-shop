function addToCart(id, opt, qty, silent){
  const key = keyOf(id, opt);
  const ex = db.cart.find(i => i.key === key);
  ex ? ex.qty = Math.min(99, ex.qty + qty) : db.cart.push({ key, id, opt, qty });
  save(); renderHeader(); renderCart();
  if (!silent) toast(`장바구니에 담았어요 · ${esc(byId(id).name)}`, '🛒');
}
function optText(it){
  const p = byId(it.id); const parts = [];
  (p.options || []).forEach(o => it.opt[o.name] && parts.push(it.opt[o.name]));
  if (it.opt.job) parts.push(`스트링 작업: ${byId(it.opt.job.string).name} · ${it.opt.job.tension}`);
  return parts.join(' / ');
}
function renderCart(){
  const u = me(); const t = totals(u);
  const n = db.cart.reduce((s, i) => s + i.qty, 0);
